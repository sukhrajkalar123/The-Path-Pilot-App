# Server env
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini
PROXY_SHARED_SECRET=replace-with-a-long-random-string

# Expo app env (public at build time)
# Local dev fallback works without this, but set this for a public proxy URL.
EXPO_PUBLIC_API_BASE_URL=https://your-proxy-domain.example
EXPO_PUBLIC_PROXY_SHARED_SECRET=replace-with-a-long-random-string
